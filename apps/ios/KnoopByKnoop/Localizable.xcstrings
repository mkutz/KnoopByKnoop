    "Knoop by Knoop needs location access to navigate. You can allow it in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoop by Knoop braucht Zugriff auf deinen Standort, um zu navigieren. Du kannst ihn in den Einstellungen erlauben."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoop by Knoop heeft toegang tot je locatie nodig om te navigeren. Je kunt dit toestaan in Instellingen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoop by Knoop a besoin d'accéder à votre position pour naviguer. Vous pouvez l'autoriser dans Réglages."
          }
        }
      }
    },
    "Knoop by Knoop needs location access to show your position. You can allow it in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoop by Knoop braucht Zugriff auf deinen Standort, um ihn zu zeigen. Du kannst ihn in den Einstellungen erlauben."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoop by Knoop heeft toegang tot je locatie nodig om je positie te tonen. Je kunt dit toestaan in Instellingen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoop by Knoop a besoin d'accéder à votre position pour l'afficher. Vous pouvez l'autoriser dans Réglages."
          }
        }
      }
    },
