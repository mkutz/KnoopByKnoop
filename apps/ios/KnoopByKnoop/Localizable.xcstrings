    "Search by Photon (komoot), data © OpenStreetMap contributors. What you type and the map's center are sent to photon.komoot.io.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche von Photon (komoot), Daten © OpenStreetMap-Mitwirkende. Was du eingibst und die Kartenmitte werden an photon.komoot.io gesendet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoeken via Photon (komoot), gegevens © OpenStreetMap-bijdragers. Wat je typt en het midden van de kaart worden naar photon.komoot.io gestuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche par Photon (komoot), données © contributeurs d'OpenStreetMap. Ce que vous tapez et le centre de la carte sont envoyés à photon.komoot.io."
          }
        }
      }
    },
